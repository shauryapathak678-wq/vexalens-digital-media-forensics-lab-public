FROM python:3.9-slim AS deepsafe-source

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN git init /opt/DeepSafe && \
    git -C /opt/DeepSafe remote add origin https://github.com/siddharthksah/DeepSafe.git && \
    git -C /opt/DeepSafe fetch --depth 1 origin 2285e8aaa30b2df0508d570172643d1cae40703f && \
    git -C /opt/DeepSafe checkout --detach FETCH_HEAD

FROM python:3.9-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=deepsafe-source /opt/DeepSafe/sdk/ /app/sdk/
RUN pip install --no-cache-dir /app/sdk/

RUN pip install --no-cache-dir --upgrade pip "setuptools<70" wheel

RUN pip install --no-cache-dir \
    torch==2.0.1 \
    torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cpu

COPY --from=deepsafe-source /opt/DeepSafe/models/image/universalfakedetect/ /app/model/
RUN pip install --no-cache-dir -r /app/model/requirements.txt

WORKDIR /app/model

RUN git init universalfakedetect && \
    git -C universalfakedetect remote add origin https://github.com/WisconsinAIVision/UniversalFakeDetect.git && \
    git -C universalfakedetect fetch --depth 1 origin 030495aea3300a8b54c0ec37ec7fe1dd7e63c619 && \
    git -C universalfakedetect checkout --detach FETCH_HEAD && \
    mkdir -p universalfakedetect/pretrained_weights && \
    python -c "import torch; import os; os.makedirs('/root/.cache/clip', exist_ok=True)" && \
    wget -O /root/.cache/clip/ViT-L-14.pt \
    https://openaipublic.azureedge.net/clip/models/b8cca3fd41ae0c99ba7e8951adf17d267cdb84cd88be6f7c2e0eca1737a03836/ViT-L-14.pt && \
    echo "b8cca3fd41ae0c99ba7e8951adf17d267cdb84cd88be6f7c2e0eca1737a03836  /root/.cache/clip/ViT-L-14.pt" | sha256sum -c - && \
    echo "477100745713bcc957beb2b40859536859b6483fd6301b3b9293151b194c7847  universalfakedetect/pretrained_weights/fc_weights.pth" | sha256sum -c -

RUN pip install --no-cache-dir opencv-python-headless==4.11.0.86 && \
    sed -i 's/version: "1.0.0"/version: "1.1.0"/; s/PRELOAD_MODEL: "false"/PRELOAD_MODEL: "true"/; s/MODEL_TIMEOUT: "600"/MODEL_TIMEOUT: "0"/' /app/model/model.yaml
COPY ufd_detector.py /app/model/detector.py

ENV MODEL_PORT=5004 \
    USE_GPU=false \
    PRELOAD_MODEL=true \
    MODEL_TIMEOUT=0

EXPOSE 5004

CMD ["deepsafe", "serve", "--manifest", "model.yaml"]
