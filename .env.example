# Optional server-side Gemini API key for supported language/transcription workflows.
# This is not a specialist image-authenticity detector.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Optional server-only ZeroTrue API key for explicitly consented audio screening.
ZEROTRUE_API_KEY=

# TruthScan API key for AI audio deepfake screening (https://detect-audio.truthscan.com)
TRUTHSCAN_API_KEY=

# Server-only TruthScan API key for AI video detection (https://detect-video.truthscan.com)
TRUTHSCAN_VIDEO_API_KEY=

# Server-only TruthScan API key for optional PDF detection (https://detect-pdf.truthscan.com).
# PDF submissions are sent only after per-analysis consent and may consume provider credits.
TRUTHSCAN_PDF_API_KEY=

# Everypixel Faces API credentials for age estimation.
# Use distinct Client ID and Client Secret values from the Everypixel Labs dashboard.
EVERYPIXEL_CLIENT_ID=
EVERYPIXEL_CLIENT_SECRET=

# GenderRecognition age-estimation API (server-only).
GENDER_RECOGNITION_API_KEY=

# Modal proxy credentials for DeepSeek image age estimation.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Optional server-only Sightengine credentials for face-manipulation deepfake detection.
# These credentials are never sent to the browser. Short video scans use Sightengine's synchronous endpoint.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Private DeepSafe image inference sidecar. Never expose these as VITE_* variables.
# For local development with deepsafe-inference/docker-compose.yml:
DEEPSAFE_IMAGE_SERVICE_URL=http://127.0.0.1:8010
# Use the same random token in deepsafe-inference/.env.
DEEPSAFE_IMAGE_SERVICE_TOKEN=
DEEPSAFE_IMAGE_TIMEOUT_MS=100000

# Optional server-only landmark detection for Media Origin Intelligence.
# Also used by Image Trace Web Detection. Enable the Google Vision API and billing
# in your Cloud project; never expose this key to client-side settings.
GOOGLE_CLOUD_VISION_API_KEY=

# Optional server-only official Image Trace provider credentials.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
TINEYE_API_KEY=

# Optional server-only AI image-origin detection key.
# Images are sent to wasitaigenerated.com only after the user explicitly consents.
WIAG_API_KEY=

# Local screenshot-forensics and email-verifier interpreter settings (no external detector API key).
# Defaults to `python`; set an absolute executable path when needed.
SCREENSHOT_PYTHON_EXECUTABLE=
# Optional path to the locally installed Tesseract executable for OCR.
TESSERACT_PATH=
# Legacy alias; TESSERACT_PATH takes precedence.
TESSERACT_CMD=

# Optional server-only JSONLink key for investigator-consented webpage metadata lookups.
# This extracts webpage metadata, not EXIF/GPS from uploaded media.
JSONLINK_API_KEY=

# Optional local media tooling paths (otherwise binaries must be on the server PATH).
EXIFTOOL_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Required for server-side HMAC certificate signing and verification.
# Generate a random 32-byte hexadecimal value; never expose it in VITE_* variables.
VEXALENS_CERT_SECRET=

# Optional API server target for Vite dev/preview proxies (defaults to http://127.0.0.1:3000).
VEXALENS_API_URL=http://127.0.0.1:3000

# Server-side document-forensics processing limits.
DOCUMENT_ANALYSIS_MAX_BYTES=20971520
DOCUMENT_ANALYSIS_MAX_PDF_PAGES=50
DOCUMENT_ANALYSIS_TIMEOUT_MS=30000
# Client-side upload label only; server values above remain authoritative.
VITE_DOCUMENT_ANALYSIS_MAX_BYTES=20971520

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration (required for cloud sync and Supabase Auth)
# The application connects automatically when these are provided.
# Use the publishable (anon) key only — never expose a service-role key or DB password here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
# Legacy alias (also accepted for backwards compatibility):
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"
