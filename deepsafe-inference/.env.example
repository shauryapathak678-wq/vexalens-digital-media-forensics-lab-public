# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same value in the VexaLens server's DEEPSAFE_IMAGE_SERVICE_TOKEN.
DEEPSAFE_IMAGE_SERVICE_TOKEN=
DEEPSAFE_IMAGE_SERVICE_PORT=8010

# These are per-container memory caps, not host RAM requirements.
DEEPSAFE_NPR_MEMORY_LIMIT=1536m
DEEPSAFE_UFD_MEMORY_LIMIT=4g
